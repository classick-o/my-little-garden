# ---------------------------------------------------------------------------
# My little garden - variabile de mediu
#
# Copiaza acest fisier in .env.local si completeaza valorile.
# .env.local NU se comite niciodata in git.
#
# NEXT_PUBLIC_* ajunge in browser. Nu pune niciodata un secret acolo.
# ---------------------------------------------------------------------------

# --- Supabase --------------------------------------------------------------
# Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Cheia service-role. Ocoleste RLS. Doar server-side, niciodata NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Gemini ----------------------------------------------------------------
# https://aistudio.google.com/apikey
# Doar server-side.
GEMINI_API_KEY=

# Optional. Implicit: gemini-3.5-flash.
# `npm run models` arata exact ce modele accepta cheia ta.
GEMINI_MODEL=

# --- Acces -----------------------------------------------------------------
# Lista de adrese care au voie sa isi faca cont NU sta aici, ci in tabelul
# public.allowed_emails din Supabase. Vezi docs/setup.md, pasul 4.

# --- Web Push --------------------------------------------------------------
# Genereaza perechea cu: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:

# --- Cron ------------------------------------------------------------------
# Secret arbitrar care protejeaza ruta de cron. Genereaza cu: openssl rand -hex 32
CRON_SECRET=

# --- Aplicatie -------------------------------------------------------------
# URL-ul public, folosit pentru redirect-ul de OAuth.
# Local: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
